{
  "name": "nexa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:sdk && next dev",
    "build": "npm run build:sdk && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "build:sdk": "node scripts/build-sdk.mjs",
    "smoke": "node scripts/smoke.mjs",
    "voice:build": "esbuild src/voice/main.ts --bundle --platform=node --format=esm --packages=external --outfile=.voice/main.mjs --log-level=warning",
    "voice": "npm run voice:build && node --env-file-if-exists=.env.local --env-file-if-exists=.env .voice/main.mjs",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@google/genai": "^2.28.0",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
