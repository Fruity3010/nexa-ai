# Nexa works with NO variables set (demo mode). Everything below is optional.

# --- AI provider (server-side only) -----------------------------------------
# Enables Claude for the support agent and research interviewer.
# Without it, a deterministic intent engine is used and labelled as such.
ANTHROPIC_API_KEY=
# NEXA_AI_MODEL=claude-opus-5

# --- Telephony: Twilio Voice (server-side only) ----------------------------
# Nexa answers calls on your Twilio number. See README → "Live phone calls".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your voice-capable Twilio number in E.164, e.g. +14155550123 (shown on the dashboard)
TWILIO_PHONE_NUMBER=
# Public HTTPS base URL of this app (deployment or tunnel). The three URLs below default to:
#   {NEXA_PUBLIC_URL}/api/voice/twilio   {NEXA_PUBLIC_URL}/api/voice/status   wss://{host}/media-stream
NEXA_PUBLIC_URL=
# Only set these if they differ from the defaults (they must match what Twilio is configured with,
# because they are part of the signed payload).
TWILIO_VOICE_WEBHOOK_URL=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_STREAM_WSS_URL=
# Optional: E.164 number to transfer escalated calls to. Without it, callers are promised a callback.
VOICE_HUMAN_HANDOFF_NUMBER=
# Local testing ONLY: accept unsigned webhook requests when no auth token is set
# NEXA_VOICE_ALLOW_UNSIGNED=true

# --- Real-time voice: Gemini Live (server-side only) ------------------------
# With these set, calls are full-duplex speech-to-speech through the voice bridge (`npm run voice`).
# Without them, calls fall back to turn-based Twilio speech recognition + the Nexa agent.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Model for post-call analysis (structured JSON)
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# Shared secret between the app and the voice bridge. Generate: openssl rand -hex 24
VOICE_BRIDGE_SECRET=
# Where the bridge reaches the Next.js app, and the port the bridge listens on
NEXA_INTERNAL_URL=http://localhost:3000
VOICE_BRIDGE_PORT=8081
VOICE_MAX_CALL_SECONDS=540
VOICE_MAX_CONCURRENT_CALLS=5

# --- Voice agent behaviour ----------------------------------------------------
# Agent name, greeting, business name, FAQs, policies, languages, escalation rules, phone voice and
# callback message are edited in the dashboard (Live Support → Agent configuration), not here.
# VOICE_AGENT_NAME is therefore not used.
# true (default): the browser call simulator is available. Real calls still need the Twilio vars.
VOICE_DEMO_MODE=true

# --- Admin access -------------------------------------------------------------
# Set to require HTTP Basic auth (any username) for the dashboard and admin APIs.
# NEXA_ADMIN_PASSWORD=

# --- Website SDK / CDN --------------------------------------------------------
# After uploading public/sdk/** to a CDN, the dashboard snippet uses this base URL
# NEXT_PUBLIC_NEXA_CDN_URL=https://cdn.example.com

# --- Storage ----------------------------------------------------------------
# Directory for the demo JSON store (default: ./.data). Falls back to memory if unwritable.
# NEXA_DATA_DIR=
